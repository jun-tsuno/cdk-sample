    </mxCell>
    <mxCell id="step1" value="&lt;b&gt;Step1_Wait&lt;/b&gt;&lt;br&gt;waitSeconds 秒待つ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#CD2264;fontColor=#232F3E;" vertex="1" parent="wf">
      <mxGeometry x="50" y="190" width="180" height="60" as="geometry" />
    </mxCell>
    <mxCell id="step2" value="&lt;b&gt;Step2_Complete&lt;/b&gt;&lt;br&gt;Pass(結果を整形)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#CD2264;fontColor=#232F3E;" vertex="1" parent="wf">
      <mxGeometry x="50" y="310" width="180" height="60" as="geometry" />
    </mxCell>
    <mxCell id="note" value="&lt;b&gt;重複起動の防止&lt;/b&gt;: 実行名 &lt;code&gt;itemId__gen&lt;/code&gt; を gen=1,2,... の順に起動を試す。&lt;br&gt;同名が RUNNING なら throw → SQS が 60 秒後に再配信。5 回失敗で DLQ へ。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E1;strokeColor=#B0A060;fontColor=#232F3E;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="cloud">
      <mxGeometry x="40" y="480" width="520" height="60" as="geometry" />
    </mxCell>
    <mxCell id="e1" value="SendMessage&lt;br&gt;{ itemId, waitSeconds }" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="sqs">
      <mxGeometry x="-0.4" relative="1" as="geometry">
        <mxPoint as="offset" />
      </mxGeometry>
    </mxCell>
    <mxCell id="e2" value="イベントソースマッピング&lt;br&gt;batchSize = 1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sqs" target="lambda">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e3" value="5 回失敗で移動&lt;br&gt;(maxReceiveCount = 5)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#C62828;fontColor=#C62828;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sqs" target="dlq">
      <mxGeometry relative="1" as="geometry" />
