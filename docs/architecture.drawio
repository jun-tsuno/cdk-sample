    <mxCell id="e4" value="StartExecution&lt;br&gt;DescribeExecution" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lambda" target="sfn">
